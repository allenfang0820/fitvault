<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Keep MSI metadata ASCII-only. The application UI uses localized content;
       this avoids WiX v3/MSI legacy code-page failures in light.exe. -->
  <!-- Build with candle -dProductVersion=<major.minor.patch>. The tag workflow
       supplies this value after validating the pushed vX.Y.Z tag. -->
  <Product Id="*" Name="FitVault" Language="1033" Version="$(var.ProductVersion)" Manufacturer="FitVault" UpgradeCode="8F9F13C8-88E3-42E7-A669-3A4C2E6D4F43">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer FitVault version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MaituIcon.ico" SourceFile="installer\maitu.ico" />
    <Property Id="ARPPRODUCTICON" Value="MaituIcon.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
        <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="FitVault">
          <Component Id="ApplicationShortcutStartMenu" Guid="{6F87CFF6-AE24-4AF4-85D6-FA2872528C6F}">
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuDir"
              Name="FitVault"
              Description="Launch FitVault"
              Target="[INSTALLFOLDER]FitVault.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="MaituIcon.ico" />
            <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\FitVault\FitVault" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="ApplicationShortcutDesktop" Guid="{C5C22E39-7E75-4C24-AAD9-23D64BC52501}">
            <Shortcut
              Id="DesktopShortcut"
              Directory="DesktopFolder"
              Name="FitVault"
              Description="Launch FitVault"
              Target="[INSTALLFOLDER]FitVault.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="MaituIcon.ico" />
            <RegistryValue Root="HKCU" Key="Software\FitVault\FitVault" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="FitVault" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="MainFeature" Title="FitVault" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcutStartMenu" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>
  </Product>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <ComponentGroupRef Id="PublishedFiles" />
    </ComponentGroup>
  </Fragment>
</Wix>
